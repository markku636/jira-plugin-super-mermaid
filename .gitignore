node_modules/

# Forge
.forge/
.env
.env.*

# Custom UI 建置產物(manifest 指向各自的 build 目錄,由 build 產生)
# gitignore 的 pattern 含 / 時錨定在本檔位置,所以 confluence/ 底下要另外列。
static/*/build/
confluence/static/*/build/

# 由 prebuild 從 react-super-mermaid/dist 複製,不進版控
static/panel/public/Virgil.woff2
confluence/static/ui/public/Virgil.woff2

# 驗證腳本與截圖(遵守「測試產物不放根目錄」慣例)
outputs/

# npm pack 產物,絕不進版控(sibling repo 躺了 95 個沒人清的 tarball)
*.tgz

# 含 npm/Atlassian token
.npmrc

# listing 素材的原始擷取。成品 submission/images/ 要進版控,中間產物不要 ——
# 隨時可用 submission/scripts/make-listing-images.mjs 重生。
submission/.shots/
