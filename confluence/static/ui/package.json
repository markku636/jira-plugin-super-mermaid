{
  "name": "super-mermaid-confluence-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc --noEmit && npm run build:macro && npm run build:config",
    "build:macro": "vite build --mode macro",
    "build:config": "vite build --mode config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge/bridge": "^4.4.0",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-super-mermaid": "^0.6.87",
    "svg-pan-zoom": "^3.6.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
