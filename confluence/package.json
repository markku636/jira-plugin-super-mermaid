{
  "name": "confluence-plugin-super-mermaid",
  "version": "0.1.0",
  "private": true,
  "description": "Super Mermaid for Confluence — render Mermaid diagrams inline in your pages. Atlassian Forge app.",
  "author": "markku636",
  "scripts": {
    "install:all": "npm install && npm --prefix static/ui install",
    "build": "npm --prefix static/ui run build",
    "dev": "npm --prefix static/ui run dev",
    "typecheck": "tsc --noEmit && npm --prefix static/ui run typecheck",
    "lint": "forge lint",
    "eligibility": "forge eligibility",
    "deploy": "npm run build && forge deploy",
    "tunnel": "forge tunnel"
  },
  "dependencies": {
    "@forge/resolver": "^1.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
